--!strict
--[=[
	@module adapters/fusion

	RepoAdapter for the Fusion repo. One package (`src/`), always the Roblox
	pipeline: Fusion's suite is TestEZ driven and every spec reaches for
	`game`/`ReplicatedStorage`, so Lune cannot host it.

	Materialization copies `src/` only; `test/` is mounted straight from the repo
	(the specs require `ReplicatedStorage.Fusion`, so they bind to the
	instrumented copy without being copied themselves).
]=]

local fs = require("@lune/fs")

local adapter = require("../adapter")

type PackageSpec = adapter.PackageSpec

local M = {}
M.name = "fusion"

local SPEC: PackageSpec = {
	name = "Fusion",
	root = ".",
	sourceRoot = "src",
	specPattern = "\\.spec\\.luau$",
	exclude = {},
	pipeline = "roblox",
	pipelineReason = "the TestEZ suite requires the Roblox datamodel (`game`, Instances)",
	ignoreFiles = { ".coverage-ignore" },
}

function M.resolvePackages(_selector: string): { PackageSpec }
	return { SPEC }
end

function M.materialize(spec: PackageSpec, buildDir: string)
	if fs.isDir(buildDir) then
		fs.removeDir(buildDir)
	end
	fs.writeDir(buildDir)
	fs.copy(spec.sourceRoot, `{buildDir}/{spec.sourceRoot}`)
end

function M.luneFramework(_spec: PackageSpec, _buildDir: string): adapter.LuneFrameworkConfig
	error("fusion never uses the lune pipeline")
end

-- The coverage runner. Mirrors test/init.server.luau (fake scheduler, TestEZ
-- bootstrap) and then dumps coverage through the stdout sentinel protocol.
-- A long-bracket template keeps the Roblox source literal.
--
-- No per-test attribution: that needs a framework hook to snapshot counters
-- between tests, and TestEZ has no plugin surface. `--per-test` is a no-op here.
local RUNNER_TEMPLATE = [==[
-- Generated by the coverage system. Runs the instrumented Fusion suite and
-- dumps coverage through stdout sentinels.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local HttpService = game:GetService("HttpService")

local Fusion = ReplicatedStorage:FindFirstChild("Fusion")
assert(Fusion, "coverage: 'Fusion' not found under ReplicatedStorage")
local testRoot = ServerScriptService:FindFirstChild("FusionTest")
assert(testRoot, "coverage: 'FusionTest' not found under ServerScriptService")

local runtime = require(Fusion._cov)
local TestEZ = require(testRoot.TestEZ) :: any
local SpecExternal = require(testRoot.SpecExternal)
local External = require(Fusion.External)

External.safetyTimerMultiplier = 1 / 20
External.setExternalProvider(SpecExternal)

-- The suite runs inside the fake scheduler, exactly as test/init.server.luau
-- drives it: queue the bootstrap, then step once to drain the queue.
local results
local ok, err = pcall(function()
	SpecExternal.doTaskDeferred(function()
		results = TestEZ.TestBootstrap:run({ testRoot.Spec })
	end)
	SpecExternal.step(0)
end)

if not ok then
	print("[[TM-COV-ERROR]]" .. tostring(err))
	return
end
if results == nil then
	-- SpecExternal.step warns and swallows errors thrown inside the queue, so a
	-- bootstrap that died leaves no results behind.
	print("[[TM-COV-ERROR]]test run did not complete (see the scheduler warning above)")
	return
end

local payload = {
	coverage = {
		hits = runtime.hits,
		total = runtime.total,
		map_sha = runtime.map_sha,
	},
	tally = {
		pass = results.successCount,
		fail = results.failureCount,
		skipped = results.skippedCount,
	},
}
local json = HttpService:JSONEncode(payload)

-- base64 over stdout: run-in-roblox re-JSONEncodes every captured log line, so
-- byte-slicing raw JSON could split a multi-byte char and drop the whole post.
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64C = {}
for i = 1, 64 do
	B64C[i - 1] = string.sub(B64, i, i)
end
local function base64encode(s)
	local out = {}
	for i = 1, #s, 3 do
		local b1 = string.byte(s, i)
		local b2 = string.byte(s, i + 1)
		local b3 = string.byte(s, i + 2)
		local n = b1 * 65536 + (b2 or 0) * 256 + (b3 or 0)
		out[#out + 1] = B64C[(n // 262144) % 64]
			.. B64C[(n // 4096) % 64]
			.. (if b2 then B64C[(n // 64) % 64] else "=")
			.. (if b3 then B64C[n % 64] else "=")
	end
	return table.concat(out)
end

local encoded = base64encode(json)
local CHUNK = 500
local total = math.max(1, math.ceil(#encoded / CHUNK))
print(("[[TM-COV-BEGIN v2 enc=base64 chunks=%d bytes=%d]]"):format(total, #encoded))
for i = 1, total do
	local slice = encoded:sub((i - 1) * CHUNK + 1, i * CHUNK)
	print(("[[TM-COV %d/%d len=%d]]%s"):format(i, total, #slice, slice))
end
print("[[TM-COV-END]]")
]==]

function M.robloxScaffold(
	_spec: PackageSpec,
	_buildDir: string,
	_runOptions: adapter.RobloxRunOptions?
): adapter.RobloxScaffold
	-- Paths are relative to <workDir>/place.project.json, i.e. .coverage/Fusion/.
	-- `test/` is mounted child-by-child rather than as a whole: the folder holds
	-- init.server.luau, which rojo turns into a Script that would auto-run the
	-- suite a second time under the Open Cloud (server context) transport.
	local projectTree = {
		["$className"] = "DataModel",
		ReplicatedStorage = {
			["$className"] = "ReplicatedStorage",
			Fusion = { ["$path"] = "build/src" },
		},
		ServerScriptService = {
			["$className"] = "ServerScriptService",
			FusionTest = {
				["$className"] = "Folder",
				Spec = { ["$path"] = "../../test/Spec" },
				Util = { ["$path"] = "../../test/Util" },
				TestEZ = { ["$path"] = "../../test/TestEZ" },
				SpecExternal = { ["$path"] = "../../test/SpecExternal.luau" },
				TestVars = { ["$path"] = "../../test/TestVars.luau" },
			},
		},
	}
	return {
		projectTree = projectTree,
		runnerSource = RUNNER_TEMPLATE,
	}
end

function M.workDir(spec: PackageSpec): string
	return `.coverage/{spec.name}`
end

return adapter.validate(M)
